# Postgres connection string.
# Local dev (Homebrew Postgres): postgres://<your-user>@localhost:5432/fantasy_hedge
DATABASE_URL=postgres://localhost:5432/fantasy_hedge

# Separate database for integration tests (name must contain "test").
TEST_DATABASE_URL=postgres://localhost:5432/fantasy_hedge_test

# Clerk. Dashboard → API Keys, after creating a free project at clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret — Dashboard → Webhooks → your endpoint → Signing Secret.
# Verifies /api/webhooks/clerk requests actually came from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Yahoo Fantasy Sports OAuth2 app — developer.yahoo.com/apps.
# Redirect URI registered with Yahoo must match: <app origin>/api/auth/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
